#!/bin/bash
# Runs the hydrogen agent CLI bundled inside Hydrogen.app with this Mac's Node.js.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

node="$(command -v node || true)"
for candidate in /opt/homebrew/bin/node /usr/local/bin/node "$HOME"/.volta/bin/node; do
  [ -n "$node" ] && break
  [ -x "$candidate" ] && node="$candidate"
done
if [ -z "$node" ]; then
  for candidate in "$HOME"/.nvm/versions/node/*/bin/node; do
    [ -x "$candidate" ] && node="$candidate"
  done
fi
if [ -z "$node" ]; then
  echo "hydrogen needs Node.js 20.10 or newer: brew install node" >&2
  exit 1
fi

export HYDROGEN_AGENT_ENTRY="$here/hydrogen.mjs"
exec "$node" "$here/hydrogen.mjs" "$@"
