+}  // namespace views
+
+// Arc's space bar at the foot of the vertical tab strip: one item per space
+// (its emoji, or a dot), the current one brightest, and a button that makes a
+// new space. Clicking an item switches to that space; right-clicking it opens
+// the group editor to rename, recolour or close the space.
+class VerticalTabStripSpaceSwitcher : public views::View,
+                                      public TabStripModelObserver {
+  METADATA_HEADER(VerticalTabStripSpaceSwitcher, views::View)
+
+ public:
+  static constexpr int kHeight = 41;
+
+  explicit VerticalTabStripSpaceSwitcher(BrowserWindowInterface* browser);
+  VerticalTabStripSpaceSwitcher(const VerticalTabStripSpaceSwitcher&) = delete;
+  VerticalTabStripSpaceSwitcher& operator=(
+      const VerticalTabStripSpaceSwitcher&) = delete;
+  ~VerticalTabStripSpaceSwitcher() override;
+
+  // While a swipe or its settle moves between spaces, `position` is the
+  // fractional index of the space in view, and each item's brightness follows
+  // it. Cleared when the sidebar comes to rest.
+  void SetPagePosition(std::optional<float> position);
+
+  void SetTabStripCollapsed(bool collapsed);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnMouseMoved(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+  std::u16string GetTooltipText(const gfx::Point& point) const override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+  void OnTabGroupFocusChanged(
+      std::optional<tab_groups::TabGroupId> new_focused_group_id,
+      std::optional<tab_groups::TabGroupId> old_focused_group_id) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+ private:
+  struct Item {
+    tab_groups::TabGroupId group;
+    tab_groups::TabGroupVisualData visual_data;
