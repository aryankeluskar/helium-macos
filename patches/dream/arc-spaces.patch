+// Names the current space (the focused tab group) above the vertical tab
+// list, the way Arc's sidebar does: the space's icon, or a dot in its colour,
+// and its name. Clicking it opens the group editor to rename or recolour the
+// space.
+class SpaceHeaderView : public views::View, public TabStripModelObserver {
+  METADATA_HEADER(SpaceHeaderView, views::View)
