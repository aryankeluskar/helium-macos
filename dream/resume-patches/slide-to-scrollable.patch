+class SpacePeekView : public views::View {
+  METADATA_HEADER(SpacePeekView, views::View)
+
+ public:
+  SpacePeekView(TabStripModel* model,
+                std::optional<tab_groups::TabGroupId> group) {
+    SetCanProcessEventsWithinSubtree(false);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+
+    if (!group.has_value()) {
+      for (int index = model->IndexOfFirstNonPinnedTab();
+           index < model->count(); ++index) {
+        AddRow(model, index);
+      }
+      return;
+    }
+
+    if (!model->group_model()) {
+      return;
+    }
+    const auto* const tab_group = model->group_model()->GetTabGroup(*group);
+    if (!tab_group) {
+      return;
+    }
+    header_title_ = tab_group->visual_data()->title();
+    header_color_ = tab_group->visual_data()->color();
+    const gfx::Range range = tab_group->ListTabs();
+    for (uint32_t index = range.start(); index < range.end(); ++index) {
+      AddRow(model, static_cast<int>(index));
+    }
+  }
+  SpacePeekView(const SpacePeekView&) = delete;
+  SpacePeekView& operator=(const SpacePeekView&) = delete;
+  ~SpacePeekView() override = default;
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    const ui::ColorProvider* const color_provider = GetColorProvider();
+    if (!color_provider) {
+      return;
+    }
+
+    const gfx::FontList font_list;
+    const int row_height =
+        GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+    const int icon_x =
+        GetLayoutConstant(LayoutConstant::kTabHorizontalPadding) +
+        kPeekIconInset;
+    const int title_x = icon_x + kPeekIconSize + kPeekTitleGap;
+    const int title_width = std::max(0, width() - title_x - icon_x);
+    int y = 0;
+
+    if (header_color_.has_value()) {
+      const SkColor group_color = color_provider->GetColor(
+          GetTabGroupTabStripColorId(*header_color_, /*active_frame=*/true));
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(group_color);
+      canvas->DrawCircle(
+          gfx::PointF(icon_x + kPeekIconSize / 2.0f, y + row_height / 2.0f),
+          kPeekGroupDotRadius, flags);
+      canvas->DrawStringRect(
+          header_title_,
+          font_list.DeriveWithWeight(gfx::Font::Weight::SEMIBOLD), group_color,
+          gfx::Rect(title_x, y, title_width, row_height));
+      y += row_height;
+    }
+
+    const SkColor title_color =
+        color_provider->GetColor(kColorTabForegroundInactiveFrameActive);
+    for (const Row& row : rows_) {
+      if (y >= height()) {
+        break;
+      }
+      if (!row.favicon.IsEmpty()) {
+        const gfx::ImageSkia icon = row.favicon.Rasterize(color_provider);
+        if (!icon.isNull()) {
+          canvas->DrawImageInt(icon, 0, 0, icon.width(), icon.height(), icon_x,
+                               y + (row_height - kPeekIconSize) / 2,
+                               kPeekIconSize, kPeekIconSize, true);
+        }
+      }
+      canvas->DrawStringRect(row.title, font_list, title_color,
+                             gfx::Rect(title_x, y, title_width, row_height));
+      y += row_height;
+    }
+  }
+
+ private:
+  struct Row {
+    ui::ImageModel favicon;
+    std::u16string title;
+  };
+
+  void AddRow(TabStripModel* model, int index) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(index);
+    TabUIHelper* const helper = tab ? TabUIHelper::From(tab) : nullptr;
+    if (!helper) {
+      return;
+    }
+    rows_.push_back(Row{helper->GetFavicon(), helper->GetTitle()});
+  }
+
+  std::u16string header_title_;
+  std::optional<tab_groups::TabGroupColorId> header_color_;
+  std::vector<Row> rows_;
+};
+
