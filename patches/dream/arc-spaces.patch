+ public:
+  static constexpr int kHeight = 30;
+
+  SpaceHeaderView(TabStripModel* model,
+                  TabStripCollectionController* controller);
+  SpaceHeaderView(const SpaceHeaderView&) = delete;
+  SpaceHeaderView& operator=(const SpaceHeaderView&) = delete;
+  ~SpaceHeaderView() override;
+
+  // Splits an emoji at the start of a space's title off as its icon, so
+  // "🏠 Home" is the icon "🏠" and the name "Home".
+  static std::pair<std::u16string, std::u16string> SplitIcon(
+      const std::u16string& title);
+
+  // Paints a space's header row into `bounds`. Shared by the live header and
