+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/vertical_tab_strip_space_switcher.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/common/space_header_view.h"
+#include "chrome/browser/ui/views/tabs/groups/tab_group_editor_bubble_view.h"
+#include "components/tabs/public/tab_group.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/events/event.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// Measured from the space switcher in ARCUI, the UI framework Arc and Dia
+// share: a 28 pt band centred above the footer's bottom 3 pt, 12 pt per dot,
+// 6 pt dots, and the trailing button 3 pt from the edge.
+constexpr int kBandHeight = 28;
+constexpr int kBandBottomInset = 3;
+constexpr int kSideInset = 31;
+constexpr int kDotPitch = 12;
+constexpr float kDotRadius = 3.0f;
+constexpr int kIconPitch = 24;
+constexpr int kIconFontSize = 14;
+constexpr int kAddButtonInset = 3;
+constexpr float kAddGlyphHalfLength = 5.0f;
+constexpr float kAddGlyphStroke = 1.5f;
+
+constexpr float kSelectedOpacity = 0.85f;
+constexpr float kHoveredOpacity = 0.4f;
+constexpr float kIdleOpacity = 0.2f;
+constexpr float kIconIdleOpacity = 0.45f;
+constexpr float kIconHoveredOpacity = 0.7f;
+constexpr float kIconSelectedOpacity = 1.0f;
+
+SkAlpha ToAlpha(float opacity) {
+  return static_cast<SkAlpha>(
+      std::lround(std::clamp(opacity, 0.0f, 1.0f) * 255.0f));
+}
+
+}  // namespace
+
+VerticalTabStripSpaceSwitcher::VerticalTabStripSpaceSwitcher(
+    BrowserWindowInterface* browser)
+    : browser_(browser), model_(browser->GetTabStripModel()) {
+  model_->AddObserver(this);
+  Rebuild();
+}
+
+VerticalTabStripSpaceSwitcher::~VerticalTabStripSpaceSwitcher() {
+  editor_bubble_.reset();
+}
+
+void VerticalTabStripSpaceSwitcher::SetPagePosition(
+    std::optional<float> position) {
+  if (page_position_ == position) {
+    return;
+  }
+  page_position_ = position;
+  SchedulePaint();
+}
+
+void VerticalTabStripSpaceSwitcher::SetTabStripCollapsed(bool collapsed) {
+  if (tab_strip_collapsed_ == collapsed) {
+    return;
+  }
+  tab_strip_collapsed_ = collapsed;
+  SetVisible(!collapsed);
+}
+
+gfx::Size VerticalTabStripSpaceSwitcher::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(0, kHeight);
+}
+
+void VerticalTabStripSpaceSwitcher::OnBoundsChanged(
+    const gfx::Rect& previous_bounds) {
+  LayoutItems();
+}
+
+void VerticalTabStripSpaceSwitcher::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* const color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const SkColor label_color =
+      color_provider->GetColor(kColorTabForegroundActiveFrameActive);
+  const gfx::FontList icon_font =
+      gfx::FontList().DeriveWithSizeDelta(kIconFontSize -
+                                          gfx::FontList().GetFontSize());
+
+  for (size_t index = 0; index < items_.size(); ++index) {
+    const Item& item = items_[index];
+    const float opacity = GetItemOpacity(index);
+    if (item.icon.empty()) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(SkColorSetA(label_color, ToAlpha(opacity)));
+      canvas->DrawCircle(gfx::RectF(item.bounds).CenterPoint(), kDotRadius,
+                         flags);
+    } else {
+      canvas->SaveLayerAlpha(ToAlpha(opacity));
+      canvas->DrawStringRectWithFlags(item.icon, icon_font, label_color,
+                                      item.bounds,
+                                      gfx::Canvas::TEXT_ALIGN_CENTER);
+      canvas->Restore();
+    }
+  }
+
+  const gfx::RectF add_bounds(GetAddButtonBounds());
+  const gfx::PointF center = add_bounds.CenterPoint();
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(kAddGlyphStroke);
+  flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  flags.setColor(SkColorSetA(
+      label_color,
+      ToAlpha(add_button_hovered_ ? kSelectedOpacity : kHoveredOpacity)));
+  canvas->DrawLine(
+      gfx::PointF(center.x() - kAddGlyphHalfLength, center.y()),
+      gfx::PointF(center.x() + kAddGlyphHalfLength, center.y()), flags);
+  canvas->DrawLine(
+      gfx::PointF(center.x(), center.y() - kAddGlyphHalfLength),
+      gfx::PointF(center.x(), center.y() + kAddGlyphHalfLength), flags);
+}
+
+bool VerticalTabStripSpaceSwitcher::OnMousePressed(
+    const ui::MouseEvent& event) {
+  return event.IsLeftMouseButton() || event.IsRightMouseButton();
+}
+
+void VerticalTabStripSpaceSwitcher::OnMouseReleased(
+    const ui::MouseEvent& event) {
+  if (!model_) {
+    return;
+  }
+  if (GetAddButtonBounds().Contains(event.location())) {
+    if (event.IsLeftMouseButton()) {
+      chrome::ExecuteCommand(browser_, IDC_NEW_SPACE);
+    }
+    return;
+  }
+  const std::optional<size_t> index = GetItemAt(event.location());
+  if (!index.has_value()) {
+    return;
+  }
+  if (event.IsRightMouseButton()) {
+    ShowEditor(*index);
+    return;
+  }
+  const tab_groups::TabGroupId group = items_[*index].group;
+  if (model_->GetFocusedGroup() != group &&
+      model_->group_model()->ContainsTabGroup(group)) {
+    model_->EnterFocusMode(group);
+  }
+}
+
+void VerticalTabStripSpaceSwitcher::OnMouseMoved(const ui::MouseEvent& event) {
+  SetHover(GetItemAt(event.location()),
+           GetAddButtonBounds().Contains(event.location()));
+}
+
+void VerticalTabStripSpaceSwitcher::OnMouseExited(
+    const ui::MouseEvent& event) {
+  SetHover(std::nullopt, false);
+}
+
+std::u16string VerticalTabStripSpaceSwitcher::GetTooltipText(
+    const gfx::Point& point) const {
+  if (GetAddButtonBounds().Contains(point)) {
+    return u"New Space";
+  }
+  const std::optional<size_t> index = GetItemAt(point);
+  return index.has_value() ? items_[*index].name : std::u16string();
+}
+
+void VerticalTabStripSpaceSwitcher::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() != TabStripModelChange::kSelectionOnly) {
+    Rebuild();
+  }
+}
+
+void VerticalTabStripSpaceSwitcher::OnTabGroupChanged(
+    const TabGroupChange& change) {
+  Rebuild();
+}
+
+void VerticalTabStripSpaceSwitcher::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  SchedulePaint();
+}
+
+void VerticalTabStripSpaceSwitcher::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  model_ = nullptr;
+  items_.clear();
+}
+
+void VerticalTabStripSpaceSwitcher::Rebuild() {
+  items_.clear();
+  if (model_ && model_->group_model()) {
+    TabGroupModel* const group_model = model_->group_model();
+    std::vector<tab_groups::TabGroupId> groups = group_model->ListTabGroups();
+    std::ranges::sort(groups, {}, [group_model](
+                                      const tab_groups::TabGroupId& id) {
+      return group_model->GetTabGroup(id)->ListTabs().start();
+    });
+    for (const tab_groups::TabGroupId& group : groups) {
+      const tab_groups::TabGroupVisualData visual_data =
+          *group_model->GetTabGroup(group)->visual_data();
+      auto [icon, name] = SpaceHeaderView::SplitIcon(visual_data.title());
+      if (name.empty()) {
+        name = u"Space";
+      }
+      items_.push_back(Item{group, visual_data, std::move(icon),
+                            std::move(name), gfx::Rect()});
+    }
+  }
+  hovered_item_.reset();
+  LayoutItems();
+  SchedulePaint();
+}
+
+void VerticalTabStripSpaceSwitcher::LayoutItems() {
+  const gfx::Rect band = GetBandBounds();
+  int total_width = 0;
+  for (const Item& item : items_) {
+    total_width += item.icon.empty() ? kDotPitch : kIconPitch;
+  }
+  int x = band.x() + (band.width() - total_width) / 2;
+  for (Item& item : items_) {
+    const int pitch = item.icon.empty() ? kDotPitch : kIconPitch;
+    item.bounds = gfx::Rect(x, band.y(), pitch, band.height());
+    x += pitch;
+  }
+}
+
+gfx::Rect VerticalTabStripSpaceSwitcher::GetBandBounds() const {
+  gfx::Rect band(0, height() - kBandBottomInset - kBandHeight, width(),
+                 kBandHeight);
+  band.Inset(gfx::Insets::VH(0, kSideInset));
+  return band;
+}
+
+gfx::Rect VerticalTabStripSpaceSwitcher::GetAddButtonBounds() const {
+  return gfx::Rect(width() - kAddButtonInset - kBandHeight,
+                   height() - kBandBottomInset - kBandHeight, kBandHeight,
+                   kBandHeight);
+}
+
+std::optional<size_t> VerticalTabStripSpaceSwitcher::GetItemAt(
+    const gfx::Point& point) const {
+  for (size_t index = 0; index < items_.size(); ++index) {
+    if (items_[index].bounds.Contains(point)) {
+      return index;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<size_t> VerticalTabStripSpaceSwitcher::GetFocusedIndex() const {
+  const std::optional<tab_groups::TabGroupId> focused =
+      model_ ? model_->GetFocusedGroup() : std::nullopt;
+  if (!focused.has_value()) {
+    return std::nullopt;
+  }
+  for (size_t index = 0; index < items_.size(); ++index) {
+    if (items_[index].group == *focused) {
+      return index;
+    }
+  }
+  return std::nullopt;
+}
+
+float VerticalTabStripSpaceSwitcher::GetItemOpacity(size_t index) const {
+  const bool icon = !items_[index].icon.empty();
+  const float idle = icon ? kIconIdleOpacity : kIdleOpacity;
+  const float selected = icon ? kIconSelectedOpacity : kSelectedOpacity;
+  const float hovered = icon ? kIconHoveredOpacity : kHoveredOpacity;
+
+  float closeness = 0.0f;
+  if (page_position_.has_value()) {
+    closeness = std::max(
+        0.0f, 1.0f - std::abs(static_cast<float>(index) - *page_position_));
+  } else if (GetFocusedIndex() == index) {
+    closeness = 1.0f;
+  }
+  float opacity = idle + (selected - idle) * closeness;
+  if (hovered_item_ == index) {
+    opacity = std::max(opacity, hovered);
+  }
+  return opacity;
+}
+
+void VerticalTabStripSpaceSwitcher::ShowEditor(size_t index) {
+  editor_bubble_.reset();
+  gfx::Rect anchor = items_[index].bounds;
+  views::View::ConvertRectToScreen(this, &anchor);
+  editor_bubble_ = TabGroupEditorBubbleView::Show(
+      browser_, items_[index].group, this, anchor,
+      /*stop_context_menu_propagation=*/false);
+}
+
+void VerticalTabStripSpaceSwitcher::SetHover(std::optional<size_t> item,
+                                             bool add_button) {
+  if (hovered_item_ == item && add_button_hovered_ == add_button) {
+    return;
+  }
+  hovered_item_ = item;
+  add_button_hovered_ = add_button;
+  SchedulePaint();
+}
+
+BEGIN_METADATA(VerticalTabStripSpaceSwitcher)
+END_METADATA
