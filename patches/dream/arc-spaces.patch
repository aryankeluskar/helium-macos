+void VerticalTabStripFocusSwipeController::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  if (focusing_ || tracking_) {
+    return;
+  }
+  if (paging_) {
+    Rest();
+  }
+
+  // Making a space leaves focus mode and enters it again on the new group in
+  // the same task; slide from the space that was left.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!new_focused_group_id.has_value()) {
+    unfocused_group_ = old_focused_group_id;
+    unfocused_time_ = now;
+    return;
+  }
+  if (!old_focused_group_id.has_value() && unfocused_group_.has_value() &&
+      now - unfocused_time_ < kRefocusWindow) {
+    old_focused_group_id = unfocused_group_;
+  }
+  unfocused_group_.reset();
+
+  if (!old_focused_group_id.has_value() ||
+      !gfx::Animation::ShouldRenderRichAnimation() ||
+      !region_view_->GetWidget() || !region_view_->GetVisible()) {
+    return;
+  }
+
+  // The space bar, Ctrl+number and the keyboard's next/previous space slide
+  // between spaces the way a swipe does.
+  const std::vector<tab_groups::TabGroupId> spaces = GetSpaces();
+  const auto from = std::ranges::find(spaces, *old_focused_group_id);
+  const auto to = std::ranges::find(spaces, *new_focused_group_id);
+  if (from == spaces.end() || to == spaces.end() || from == to) {
+    return;
+  }
+
+  spaces_ = spaces;
+  real_page_ = static_cast<int>(to - spaces.begin());
+  position_ = static_cast<float>(from - spaces.begin());
+  paging_ = true;
+  page_colors_.clear();
+  for (views::View* view : GetSlideViews()) {
+    EnsureLayer(view);
+  }
+  SnapUnpinnedLayout();
+  Settle(real_page_, 0.0f);
+}
