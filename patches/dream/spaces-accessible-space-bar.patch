+
+void VerticalTabStripSpaceSwitcher::SetPressed(std::optional<size_t> item,
+                                               bool add_button) {
+  if (pressed_item_ == item && add_button_pressed_ == add_button) {
+    return;
+  }
+  pressed_item_ = item;
+  add_button_pressed_ = add_button;
+  SchedulePaint();
+}
+
+void VerticalTabStripSpaceSwitcher::UpdateAccessibleItems() {
+  const std::optional<size_t> focused = GetFocusedIndex();
+  for (size_t index = 0; index < items_.size() && index < item_views_.size();
+       ++index) {
+    views::ViewAccessibility& accessibility =
+        item_views_[index]->GetViewAccessibility();
+    accessibility.SetRole(ax::mojom::Role::kTab);
+    accessibility.SetName(items_[index].name);
+    accessibility.SetPosInSet(static_cast<int>(index) + 1);
+    accessibility.SetSetSize(static_cast<int>(items_.size()));
+    accessibility.SetIsSelected(focused == index);
+  }
+}
