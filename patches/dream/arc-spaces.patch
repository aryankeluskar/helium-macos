+
+namespace {
+
+constexpr int kIconInset = 7;
+constexpr int kIconSize = 16;
+constexpr int kTitleGap = 8;
+constexpr int kEmojiFontSize = 13;
+constexpr float kDotRadius = 4.0f;
+
+}  // namespace
+
+SpaceHeaderView::SpaceHeaderView(TabStripModel* model,
+                                 TabStripCollectionController* controller)
+    : model_(model), controller_(controller) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  model_->AddObserver(this);
+  Update();
+}
+
+SpaceHeaderView::~SpaceHeaderView() {
+  editor_bubble_.reset();
+}
+
+// static
+std::pair<std::u16string, std::u16string> SpaceHeaderView::SplitIcon(
+    const std::u16string& title) {
+  if (title.empty()) {
+    return {std::u16string(), title};
+  }
+
+  size_t offset = 0;
+  UChar32 first = 0;
+  U16_NEXT(title.data(), offset, title.size(), first);
+  if (!u_hasBinaryProperty(first, UCHAR_EXTENDED_PICTOGRAPHIC) &&
+      !u_hasBinaryProperty(first, UCHAR_REGIONAL_INDICATOR)) {
+    return {std::u16string(), title};
+  }
+
+  base::i18n::BreakIterator graphemes(
+      title, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (!graphemes.Init() || !graphemes.Advance()) {
+    return {std::u16string(), title};
+  }
+  std::u16string name;
+  base::TrimWhitespace(std::u16string_view(title).substr(graphemes.pos()),
+                       base::TRIM_LEADING, &name);
+  return {title.substr(0, graphemes.pos()), std::move(name)};
+}
+
+// static
+void SpaceHeaderView::Paint(gfx::Canvas* canvas,
+                            const gfx::Rect& bounds,
+                            const ui::ColorProvider* color_provider,
+                            const tab_groups::TabGroupVisualData& visual_data) {
+  if (!color_provider) {
+    return;
+  }
+
+  auto [icon, name] = SplitIcon(visual_data.title());
+  if (name.empty()) {
+    name = u"Space";
+  }
+
+  const int icon_x = bounds.x() +
+                     GetLayoutConstant(LayoutConstant::kTabHorizontalPadding) +
+                     kIconInset;
+  const int title_x = icon_x + kIconSize + kTitleGap;
+  const int title_width = std::max(0, bounds.right() - title_x - kIconInset);
+  const gfx::Rect icon_bounds(icon_x,
+                              bounds.y() + (bounds.height() - kIconSize) / 2,
+                              kIconSize, kIconSize);
+  const gfx::FontList font_list;
+
+  if (icon.empty()) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_provider->GetColor(GetTabGroupTabStripColorId(
+        visual_data.color(), /*active_frame=*/true)));
+    canvas->DrawCircle(gfx::PointF(icon_bounds.CenterPoint()), kDotRadius,
+                       flags);
+  } else {
+    canvas->DrawStringRectWithFlags(
+        icon,
+        font_list.DeriveWithSizeDelta(kEmojiFontSize -
+                                      font_list.GetFontSize()),
+        color_provider->GetColor(kColorTabForegroundActiveFrameActive),
+        icon_bounds, gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+  canvas->DrawStringRect(
+      name, font_list.DeriveWithWeight(gfx::Font::Weight::SEMIBOLD),
+      color_provider->GetColor(kColorTabForegroundInactiveFrameActive),
+      gfx::Rect(title_x, bounds.y(), title_width, bounds.height()));
+}
+
+void SpaceHeaderView::SetTabStripCollapsed(bool collapsed) {
+  if (tab_strip_collapsed_ == collapsed) {
+    return;
+  }
+  tab_strip_collapsed_ = collapsed;
+  Update();
+}
+
+void SpaceHeaderView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  Paint(canvas, GetLocalBounds(), GetColorProvider(), visual_data_);
+}
+
+bool SpaceHeaderView::OnMousePressed(const ui::MouseEvent& event) {
+  return event.IsLeftMouseButton() || event.IsRightMouseButton();
+}
+
+void SpaceHeaderView::OnMouseReleased(const ui::MouseEvent& event) {
+  if (HitTestPoint(event.location())) {
+    ToggleEditor();
+  }
+}
+
+void SpaceHeaderView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();
+}
+
+void SpaceHeaderView::OnTabGroupChanged(const TabGroupChange& change) {
+  if (change.group == group_ &&
+      change.type == TabGroupChange::kVisualsChanged) {
+    Update();
+  }
+}
+
+void SpaceHeaderView::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  editor_bubble_.reset();
+  Update();
+}
+
+void SpaceHeaderView::OnTabStripModelDestroyed(TabStripModel* tab_strip_model) {
+  model_ = nullptr;
+  group_.reset();
+}
+
+void SpaceHeaderView::Update() {
+  group_.reset();
+  if (model_ && model_->group_model()) {
+    if (const std::optional<tab_groups::TabGroupId> focused =
+            model_->GetFocusedGroup();
+        focused.has_value()) {
+      if (const TabGroup* const tab_group =
+              model_->group_model()->GetTabGroup(*focused)) {
+        group_ = focused;
+        visual_data_ = *tab_group->visual_data();
+      }
+    }
+  }
+  SetVisible(group_.has_value() && !tab_strip_collapsed_);
+  SchedulePaint();
+}
+
+void SpaceHeaderView::ToggleEditor() {
+  if (editor_bubble_ && !editor_bubble_->IsClosed()) {
+    editor_bubble_.reset();
+    return;
+  }
+  editor_bubble_.reset();
+  if (group_.has_value() && controller_) {
+    editor_bubble_ = controller_->ShowGroupEditorBubble(
+        *group_, this, /*stop_context_menu_propagation=*/false);
+  }
+}
