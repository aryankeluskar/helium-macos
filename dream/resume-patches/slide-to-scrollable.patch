+std::optional<VerticalTabStripFocusSwipeController::SpaceTarget>
+VerticalTabStripFocusSwipeController::PeekRotation(bool forward) const {
+  TabStripModel* const model = region_view_->tab_strip_model();
+  if (!model || !model->group_model()) {
+    return std::nullopt;
+  }
+
+  const std::optional<tab_groups::TabGroupId> current =
+      model->GetFocusedGroup();
+  if (current.has_value() && model->IsEphemeralTabGroup(*current)) {
+    return std::nullopt;
+  }
+
+  std::vector<tab_groups::TabGroupId> groups =
+      model->group_model()->ListTabGroups();
+  if (groups.empty()) {
+    return std::nullopt;
+  }
+  std::ranges::sort(groups, {}, [model](const tab_groups::TabGroupId& id) {
+    return model->group_model()->GetTabGroup(id)->ListTabs().start();
+  });
+
+  if (!current.has_value()) {
+    return SpaceTarget{forward ? groups.front() : groups.back()};
+  }
+
+  const auto it = std::ranges::find(groups, *current);
+  if (it == groups.end()) {
+    return SpaceTarget{std::nullopt};
+  }
+  if (forward) {
+    const auto next = std::next(it);
+    return next != groups.end() ? SpaceTarget{*next}
+                                : SpaceTarget{std::nullopt};
+  }
+  return it != groups.begin() ? SpaceTarget{*std::prev(it)}
+                              : SpaceTarget{std::nullopt};
+}
+
+bool VerticalTabStripFocusSwipeController::IsForward(float x) const {
+  return (x < 0) != base::i18n::IsRTL();
+}
+
+void VerticalTabStripFocusSwipeController::BeginTracking() {
+  views::View* const target = GetSlideTarget();
+  if (!target || !region_view_->tab_strip_model() ||
+      !gfx::Animation::ShouldRenderRichAnimation()) {
+    return;
+  }
+
+  FinishSettling();
+  if (!target->layer()) {
+    target->SetPaintToLayer();
+    target->layer()->SetFillsBoundsOpaquely(false);
+  }
+  target->layer()->SetOpacity(1.0f);
+
+  tracking_ = true;
+  track_x_ = 0.0f;
+  shown_x_ = 0.0f;
+  velocity_ = 0.0f;
+  last_track_time_ = base::TimeTicks::Now();
+  peek_forward_.reset();
+}
+
+void VerticalTabStripFocusSwipeController::UpdateTracking(float x) {
+  views::View* const target = GetSlideTarget();
+  if (!target || !target->layer()) {
+    EndTracking();
+    return;
+  }
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const double elapsed_ms = (now - last_track_time_).InMillisecondsF();
+  if (elapsed_ms > 0) {
+    const float instant_velocity =
+        static_cast<float>((x - track_x_) / elapsed_ms);
+    velocity_ = 0.6f * instant_velocity + 0.4f * velocity_;
+  }
+  last_track_time_ = now;
+  track_x_ = x;
+
+  const bool forward = IsForward(x);
+  const std::optional<SpaceTarget> neighbor =
+      x == 0.0f ? std::optional<SpaceTarget>() : PeekRotation(forward);
+  const float width = static_cast<float>(std::max(1, target->width()));
+  shown_x_ =
+      neighbor.has_value() ? std::clamp(x, -width, width) : x * kEdgeResistance;
+
+  if (!neighbor.has_value() || peek_forward_ != forward) {
+    if (views::View* const peek = incoming_peek_.view()) {
+      incoming_peek_.SetView(nullptr);
+      std::unique_ptr<views::View> removed =
+          peek->parent()->RemoveChildViewT(peek);
+    }
+    peek_forward_.reset();
+  }
+  if (neighbor.has_value() && !incoming_peek_.view()) {
+    incoming_peek_.SetView(AddPeekView(*neighbor));
+    peek_forward_ = forward;
+  }
+
+  SetTranslation(target, shown_x_);
+  if (views::View* const peek = incoming_peek_.view()) {
+    SetTranslation(peek, shown_x_ + (shown_x_ < 0 ? width : -width));
+  }
+
+  end_timer_.Start(
+      FROM_HERE, kGestureResetTimeout,
+      base::BindOnce(&VerticalTabStripFocusSwipeController::EndTracking,
+                     base::Unretained(this)));
+}
+
+void VerticalTabStripFocusSwipeController::EndTracking() {
+  if (!tracking_) {
+    return;
+  }
+  tracking_ = false;
+  has_triggered_in_current_gesture_ = true;
+  end_timer_.Stop();
+  ++settle_id_;
+
+  views::View* const target = GetSlideTarget();
+  TabStripModel* const model = region_view_->tab_strip_model();
+  if (!target || !target->layer() || !model) {
+    RemovePeekViews();
+    return;
+  }
+
+  const float width = static_cast<float>(std::max(1, target->width()));
+  const bool forward = IsForward(track_x_);
+  const bool flung = std::abs(velocity_) >= kCommitVelocity &&
+                     (velocity_ < 0) == (track_x_ < 0);
+  const bool commit = incoming_peek_.view() && peek_forward_ == forward &&
+                      (std::abs(shown_x_) >= width * kCommitFraction || flung);
+  const float exit_x = shown_x_ < 0 ? -width : width;
+
+  views::AnimationBuilder builder;
+  builder.SetPreemptionStrategy(ui::LayerAnimator::IMMEDIATELY_SET_NEW_TARGET)
+      .OnEnded(base::BindOnce(
+          &VerticalTabStripFocusSwipeController::OnSettleAnimationDone,
+          weak_factory_.GetWeakPtr(), settle_id_))
+      .OnAborted(base::BindOnce(
+          &VerticalTabStripFocusSwipeController::OnSettleAnimationDone,
+          weak_factory_.GetWeakPtr(), settle_id_));
+
+  if (commit) {
+    views::View* const outgoing =
+        AddPeekView(SpaceTarget{model->GetFocusedGroup()});
+    outgoing_peek_.SetView(outgoing);
+    SetTranslation(outgoing, shown_x_);
+
+    views::View* const incoming = incoming_peek_.view();
+    incoming_peek_.SetView(nullptr);
+    std::unique_ptr<views::View> removed =
+        incoming->parent()->RemoveChildViewT(incoming);
+
+    model->RotateFocusedGroup(forward);
+    SetTranslation(target, shown_x_ - exit_x);
+
+    builder.Once()
+        .SetDuration(kSettleDuration)
+        .SetTransform(target, gfx::Transform(), gfx::Tween::EASE_OUT)
+        .SetTransform(outgoing, Translation(exit_x), gfx::Tween::EASE_OUT);
+  } else if (views::View* const incoming = incoming_peek_.view()) {
+    builder.Once()
+        .SetDuration(kSettleDuration)
+        .SetTransform(target, gfx::Transform(), gfx::Tween::EASE_OUT)
+        .SetTransform(incoming, Translation(-exit_x), gfx::Tween::EASE_OUT);
+  } else {
+    builder.Once()
+        .SetDuration(kSettleDuration)
+        .SetTransform(target, gfx::Transform(), gfx::Tween::EASE_OUT);
+  }
+
+  track_x_ = 0.0f;
+  shown_x_ = 0.0f;
+  velocity_ = 0.0f;
+  peek_forward_.reset();
+}
+
+void VerticalTabStripFocusSwipeController::FinishSettling() {
+  ++settle_id_;
+  if (views::View* const target = GetSlideTarget(); target && target->layer()) {
+    target->layer()->GetAnimator()->StopAnimating();
+  }
+  RemovePeekViews();
+}
+
+void VerticalTabStripFocusSwipeController::OnSettleAnimationDone(
+    int settle_id) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VerticalTabStripFocusSwipeController::OnSettled,
+                     weak_factory_.GetWeakPtr(), settle_id));
+}
+
+void VerticalTabStripFocusSwipeController::OnSettled(int settle_id) {
+  if (settle_id != settle_id_ || tracking_) {
+    return;
+  }
+  RemovePeekViews();
+}
+
+views::View* VerticalTabStripFocusSwipeController::AddPeekView(
+    const SpaceTarget& space) {
+  views::View* const target = GetSlideTarget();
+  TabStripView* const tab_strip_view = region_view_->tab_strip_view();
+  auto peek = std::make_unique<SpacePeekView>(region_view_->tab_strip_model(),
+                                              space.group);
+  peek->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  peek->SetBoundsRect(target->bounds());
+  return tab_strip_view->AddChildView(std::move(peek));
+}
+
+void VerticalTabStripFocusSwipeController::RemovePeekViews() {
+  for (views::ViewTracker* const tracker : {&incoming_peek_, &outgoing_peek_}) {
+    if (views::View* const peek = tracker->view()) {
+      tracker->SetView(nullptr);
+      std::unique_ptr<views::View> removed =
+          peek->parent()->RemoveChildViewT(peek);
+    }
+  }
+}
