+void FocusSpace(BrowserWindowInterface* browser, int space_index) {
+  TabStripModel* const tab_strip_model = browser->GetTabStripModel();
+  if (!tab_strip_model->SupportsTabGroups() ||
+      !base::FeatureList::IsEnabled(features::kTabGroupsFocusing)) {
+    return;
+  }
+
+  const std::vector<tab_groups::TabGroupId> spaces =
+      GetSpacesInOrder(tab_strip_model);
+  if (space_index < 0 || static_cast<size_t>(space_index) >= spaces.size()) {
+    return;
+  }
+
+  ExitEphemeralFocusMode(tab_strip_model);
+  tab_strip_model->EnterFocusMode(spaces[static_cast<size_t>(space_index)]);
+}
+
+void NewSpace(BrowserWindowInterface* browser) {
+  TabStripModel* const tab_strip_model = browser->GetTabStripModel();
+  if (!tab_strip_model->SupportsTabGroups() ||
+      !base::FeatureList::IsEnabled(features::kTabGroupsFocusing)) {
+    return;
+  }
+
+  tab_strip_model->ExitFocusMode(TabGroupFocusExitReason::kGroupCreated);
+
+  if (tab_strip_model->group_model()->ListTabGroups().empty()) {
+    const std::vector<int> ungrouped_tab_indices =
+        GetUngroupedTabIndices(browser);
+    if (!ungrouped_tab_indices.empty()) {
+      tab_strip_model->AddToNewGroup(ungrouped_tab_indices);
+    }
+  }
+
+  content::WebContents* const new_tab_contents = AddAndReturnTabAt(
+      browser, GURL(), tab_strip_model->count(), true, std::nullopt, false,
+      NavigateParams::WindowAction::kShowWindow);
+  if (!new_tab_contents) {
+    return;
+  }
+
+  const int new_tab_index =
+      tab_strip_model->GetIndexOfWebContents(new_tab_contents);
+  if (new_tab_index == TabStripModel::kNoTab) {
+    return;
+  }
+
+  const tab_groups::TabGroupId new_space =
+      tab_strip_model->AddToNewGroup({new_tab_index});
+  tab_strip_model->EnterFocusMode(new_space);
+}
