+// An item of the space bar as accessibility and the keyboard see it. Mouse
+// events go to the bar, which paints the items.
+class SpaceBarItemView : public views::View {
+  METADATA_HEADER(SpaceBarItemView, views::View)
+
+ public:
+  SpaceBarItemView(base::RepeatingClosure activate,
+                   base::RepeatingClosure show_menu)
+      : activate_(std::move(activate)), show_menu_(std::move(show_menu)) {
+    SetCanProcessEventsWithinSubtree(false);
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    views::FocusRing::Install(this);
+  }
+
+  bool HandleAccessibleAction(const ui::AXActionData& action_data) override {
+    if (action_data.action == ax::mojom::Action::kDoDefault) {
+      activate_.Run();
+      return true;
+    }
+    if (action_data.action == ax::mojom::Action::kShowContextMenu &&
+        show_menu_) {
+      show_menu_.Run();
+      return true;
+    }
+    return views::View::HandleAccessibleAction(action_data);
+  }
+
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    if (event.key_code() == ui::VKEY_RETURN ||
+        event.key_code() == ui::VKEY_SPACE) {
+      activate_.Run();
+      return true;
+    }
+    return views::View::OnKeyPressed(event);
+  }
+
+ private:
+  base::RepeatingClosure activate_;
+  base::RepeatingClosure show_menu_;
+};
